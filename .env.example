# Postgres (local ou Supabase). No Supabase use a URL do pooler (porta 6543) em DATABASE_URL
# e a conexão direta (porta 5432) em DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leilao"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/leilao"

# Senha única de acesso e segredo para assinar o cookie (gere com: openssl rand -hex 32)
APP_PASSWORD="troque-esta-senha"
AUTH_SECRET="troque-por-um-segredo-longo"
