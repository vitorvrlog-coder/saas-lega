# Banco de dados (assincrono, usado pela aplicacao)
DATABASE_URL=postgresql+asyncpg://lastmile:lastmile@postgres:5432/lastmile_engine

# Gateway WhatsApp (evolution-go, reaproveitado do stack heimdall)
EVOLUTION_BASE_URL=http://heimdall-evolution-go:8080
# Chave mestre do evolution-go (env GLOBAL_API_KEY dele) — só pra criar
# instância nova no onboarding de um tenant.
EVOLUTION_GLOBAL_API_KEY=
# Endereço deste serviço na rede docker, pra onde o evolution-go manda os
# webhooks das instâncias criadas por ele.
WEBHOOK_BASE_URL=http://heimdall-driver-api:8000

# Provedor de IA: "ollama" ou "anthropic"
AI_PROVIDER=ollama
# Se o Ollama estiver containerizado no mesmo compose/rede, use o nome do
# serviço (ex: http://ollama:11434). Se o Ollama rodar nativo no host (fora
# de container, como neste ambiente de dev), use http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://ollama:11434
# qwen3:8b (modelo "thinking") estourava os 120s de timeout em hardware sem
# GPU — qwen2.5:3b responde em ~2s (já com o modelo carregado em memória) e
# segue bem instruções de JSON estrito.
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Geocoding
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO

# API key exigida (header X-Internal-Api-Key) nos endpoints internos (fila
# humana / consulta de ocorrências). Também liga/desliga o bypass de dev do
# dashboard web: vazio = sem login nenhum (todo mundo vira admin da
# plataforma fantasma — só pra dev local). Configurada = dashboard exige
# login de verdade (usuário/senha, ver app.db.models.user.User e
# scripts/create_admin.py pra criar o primeiro admin).
INTERNAL_API_KEY=

# Assina o cookie de sessão do login do dashboard — troque em produção,
# nunca reaproveite o default.
SECRET_KEY=dev-insecure-secret-key-change-in-production
